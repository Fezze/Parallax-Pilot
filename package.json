{
  "name": "parallax-pilot-workspace",
  "version": "2.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "version:bump:patch": "node scripts/version-proxy.mjs patch",
    "version:bump:minor": "node scripts/version-proxy.mjs minor",
    "version:bump:major": "node scripts/version-proxy.mjs major",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node --import ./tests/register-zepp-globals.mjs --test",
    "test:coverage": "c8 --all --src zepp-app/shared --exclude tests/** --exclude zepp-app/shared/page-ui.js --exclude zepp-app/shared/storage.js --reporter=text --reporter=html --reporter=lcov node --import ./tests/register-zepp-globals.mjs --test",
    "test:playwright": "playwright test",
    "test:playwright:screens": "playwright test tests/playwright/page-preview.spec.js",
    "test:playwright:headed": "playwright test --headed",
    "playwright:install": "playwright install chromium",
    "backend:package": "node scripts/backend-maven.mjs -DskipTests package",
    "backend:test": "node scripts/backend-maven.mjs -Dtest=ScopeResolverTest,IdempotencyRepositoryTest,SeasonServiceTest test",
    "backend:verify": "node scripts/backend-maven.mjs -DskipTests=false verify",
    "build": "node scripts/zeus-proxy.mjs build",
    "build:backend": "node scripts/backend-maven.mjs -DskipTests package",
    "build:raw": "cmd /c \"cd /d zepp-app && zeus build\"",
    "dev": "node scripts/zeus-proxy.mjs dev",
    "preview": "node scripts/zeus-proxy.mjs preview",
    "push": "node scripts/git-push-proxy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "c8": "^11.0.0"
  }
}
