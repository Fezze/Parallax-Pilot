{
  "id": "gameplay-smoke",
  "requires": ["simulator", "input", "screenshot"],
  "steps": [
    { "action": "wait", "ms": 3000 },
    { "action": "focus", "target": "deviceWindow" },
    { "action": "key", "key": "Home" },
    { "action": "tap", "target": "tutorialStart" },
    { "action": "swipe", "target": "boardCenter", "dx": -180, "dy": 0, "durationMs": 350 },
    { "action": "tap", "target": "quickMenuMode" },
    { "action": "tap", "target": "modeRound" },
    { "action": "screenshot", "name": "round-board" }
  ]
}