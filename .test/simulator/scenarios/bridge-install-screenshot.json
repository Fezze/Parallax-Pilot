{
  "id": "bridge-install-screenshot",
  "requires": ["simulator", "input", "screenshot"],
  "steps": [
    { "action": "bridge" },
    { "action": "connect", "timeoutMs": 20000 },
    { "action": "install" },
    { "action": "wait", "ms": 2000 },
    { "action": "focus" },
    { "action": "screenshot", "name": "bridge-install" }
  ]
}